{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "dest": "/en/index.html"
    },
    {
      "src": "^/en/?$",
      "dest": "/en/index.html"
    },
    {
      "src": "^/de/?$",
      "dest": "/de/index.html"
    },
    {
      "src": "^/fr/?$",
      "dest": "/fr/index.html"
    },
    {
      "src": "^/nl/?$",
      "dest": "/nl/index.html"
    },
    {
      "src": "^/zh/?$",
      "dest": "/zh/index.html"
    },
    {
      "src": "^/vi/?$",
      "dest": "/vi/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
