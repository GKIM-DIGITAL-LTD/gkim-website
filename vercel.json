{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/adora-gkim-board",
      "destination": "/adora-gkim-board.html"
    },
    {
      "source": "/adora/womens-health-intelligence-platform",
      "destination": "/adora/womens-health-intelligence-platform.html"
    }
  ],
  "headers": [
    {
      "source": "/embed",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.gkim.digital https://*.gmg.digital"
        }
      ]
    },
    {
      "source": "/embeds/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.gkim.digital https://*.gmg.digital"
        }
      ]
    },
    {
      "source": "/((?!embed$|embed\\?|embeds/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
